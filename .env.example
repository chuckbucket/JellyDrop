JELLYFIN_URL=http://localhost:8096
JELLYFIN_API_KEY=changeme
PORT=8080

# "open" (default): login is optional, everyone can browse/download as before.
# "required": every page requires logging in with a Jellyfin account.
AUTH_MODE=open

# Set to "true" only when JellyDrop is served over HTTPS — otherwise the session cookie is
# silently dropped on plain-HTTP LAN access (e.g. http://192.168.x.x:8080).
COOKIE_SECURE=false
